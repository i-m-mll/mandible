#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  directory=$(CDPATH= cd -- "$(dirname "$script")" && pwd -P)
  link=$(readlink "$script")
  case "$link" in /*) script=$link ;; *) script=$directory/$link ;; esac
done
root=$(CDPATH= cd -- "$(dirname "$script")/.." && pwd -P)
if [ -n "${MANDIBLE_RELEASE_ROOT:-}" ] || [ -f "$root/release.json" ] || [ -d "$root/../MacOS" ]; then
  root=${MANDIBLE_RELEASE_ROOT:-$root}
  case "$root" in /*) ;; *) echo 'MANDIBLE_RELEASE_ROOT must be absolute' >&2; exit 1 ;; esac
  exec "$root/../MacOS/mandible-bun" --no-install "$root/scripts/installed-command.mjs" "$@"
fi
exec /bin/zsh "$root/cli/main.zsh" "$@"
