{
  "productName": "Mandible",
  "version": "0.1.0",
  "identifier": "bio.mll.mandible",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "scripts/make-dist.sh",
    "beforeBuildCommand": "scripts/make-dist.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mandible",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mandible"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": {
      "resources/app-payload/Contents/Resources/": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "15.0",
      "files": {
        "Library/LaunchAgents": "resources/app-payload/Contents/Library/LaunchAgents"
      },
      "entitlements": null,
      "frameworks": [
        "resources/libsqlite3.dylib"
      ]
    },
    "externalBin": [
      "binaries/mandible-bun",
      "binaries/mandible-caddy",
      "binaries/mandible-claude",
      "binaries/mandible-trust-helper",
      "binaries/mandible-service"
    ]
  }
}
