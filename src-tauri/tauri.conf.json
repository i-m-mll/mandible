{
  "productName": "Mandible",
  "version": "0.1.0",
  "identifier": "bio.mll.mandible",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "scripts/make-dist.sh",
    "beforeBuildCommand": "scripts/make-dist.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mandible",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": null
    }
  }
}
