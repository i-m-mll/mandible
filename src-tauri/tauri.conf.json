{
  "productName": "Mandible",
  "version": "0.1.0",
  "identifier": "bio.mll.mandible",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "scripts/make-dist.sh",
    "beforeBuildCommand": "scripts/make-dist.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mandible",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 22 },
        "backgroundColor": "#0b0f14"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mandible"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": {
      "../scripts/local-ca-trust.mjs": "local-ca-trust.mjs",
      "../scripts/local-runtime.mjs": "local-runtime.mjs",
      "../scripts/canonical-origin.mjs": "canonical-origin.mjs",
      "../scripts/build-revision.mjs": "build-revision.mjs",
      "../scripts/pinned-caddy.mjs": "pinned-caddy.mjs",
      "resources/local-ca-trust-helper": "local-ca-trust-helper"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": null
    }
  }
}
