{"author":{"id":"89da5fec8eff6d69dbcdd68f81be7e9163b16f34b17e978ecf3554487379f453"},"ops":[{"type":1,"timestamp":1774127567,"nonce":"E5V2I2r19XgpKYN8lIYIhD5Kr+0=","title":"agent-commit: block commits to protected branches","message":"agent-commit should check the current branch and refuse to commit if it is the protected branch (develop if exists, else main). Currently there is no guard — an agent can accidentally commit directly to main, as happened with the agent-inbox.svg move.\n\nFix: in agent-commit, after determining the repo root, check `git rev-parse --abbrev-ref HEAD`. If it matches the protected branch, exit with an error message directing the agent to use a feature branch.\n\nThis is in the dotfiles repo: ~/.dotfiles/bin/agent-commit","files":null}]}