#!/usr/bin/env bash
# dwt - Delete git worktree
# Removes a linked worktree and optionally deletes the branch
#
# Usage: dwt <branch> [--force] [--keep-branch]
#
# Options:
#   --force, -f       Force removal even with uncommitted changes
#   --keep-branch, -k Keep the branch after removing the worktree
#
# See also: wt (create worktree), wt-sync (sync symlinks)

set -o pipefail

GIT_ENV_HELPER="${MANDIBLE_CLI_DIR:-$(cd "$(dirname "$0")" && pwd)}/git-env.sh"
source "$GIT_ENV_HELPER"

# Help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  cat >&2 <<'EOF'
usage: dwt <branch> [--force] [--keep-branch]

Removes a git worktree and optionally deletes the branch.

Arguments:
  branch              Branch name of the worktree to remove

Options:
  --force, -f         Force removal even with uncommitted changes
  --keep-branch, -k   Keep the branch after removing the worktree

Examples:
  dwt feature/foo              # Remove worktree and delete branch
  dwt feature/foo --keep       # Remove worktree but keep branch
  dwt feature/foo --force      # Force remove with uncommitted changes

See also: wt (create worktree), wt-sync (sync symlinks)
EOF
  exit 0
fi

force=0
keep_branch=0
branch=""

for arg in "$@"; do
  case "$arg" in
    --force|-f) force=1 ;;
    --keep-branch|--keep|-k) keep_branch=1 ;;
    --) shift; break ;;
    -*) printf '%s\n' "error: unknown option: $arg" >&2; exit 2 ;;
    *) branch="$arg" ;;
  esac
done

if [[ -z "$branch" ]]; then
  printf '%s\n' "usage: dwt <branch> [--force] [--keep-branch]" >&2
  exit 2
fi

command -v git >/dev/null 2>&1 || { printf '%s\n' "error: git not found in PATH" >&2; exit 127; }

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  printf '%s\n' "error: not inside a Git working tree" >&2
  exit 1
fi

# Get repo root: for submodules, core.worktree points to the actual working directory;
# for regular repos, go up one level from git-common-dir
repo_root=$(git config --get core.worktree 2>/dev/null)
if [[ -z "$repo_root" ]]; then
  common_git_dir=$(git rev-parse --git-common-dir 2>/dev/null) || {
    printf '%s\n' "error: failed to resolve common git dir" >&2
    exit 1
  }
  repo_root=$(cd "$common_git_dir/.." 2>/dev/null && pwd -P) || {
    printf '%s\n' "error: failed to resolve repository root" >&2
    exit 1
  }
fi

safe="${branch// /-}"; safe="${safe//\//__}"
wt_root="$repo_root/worktrees"
candidate="$wt_root/$safe"
wt_dir=""

if [[ -d "$candidate" ]]; then
  wt_dir="$candidate"
else
  current_path="" found_path=""
  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      current_path="${line#worktree }"
    elif [[ "$line" == branch\ refs/heads/* ]]; then
      b="${line#branch refs/heads/}"
      [[ "$b" == "$branch" ]] && found_path="$current_path"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain)
  [[ -n "$found_path" ]] && wt_dir="$found_path"
fi

if [[ -z "$wt_dir" || ! -d "$wt_dir" ]]; then
  printf '%s\n' "error: worktree for branch '$branch' not found" >&2
  exit 1
fi

if (( ! force )); then
  if ! git -C "$wt_dir" diff --quiet --no-ext-diff; then
    printf '%s\n' "error: unstaged changes present (use --force to override)" >&2
    exit 1
  fi
  if ! git -C "$wt_dir" diff --cached --quiet --no-ext-diff; then
    printf '%s\n' "error: staged changes present (use --force to override)" >&2
    exit 1
  fi
fi

# Bug: a247bc3 — release work units if branch has no unique commits and has .issue file
if [[ -f "$wt_dir/.issue" ]]; then
  # Check if the branch has unique commits ahead of its merge base
  merge_base=""
  has_unique_commits=0
  # Try to find merge base with the parent branch (strip child suffix from __ branches)
  parent_ref=""
  if [[ "$branch" == *__* ]]; then
    parent_ref="${branch%%__*}"
    # Convert back from safe form if needed
    parent_ref="${parent_ref//__//}"
  fi
  # Fall back to common ancestors
  if [[ -n "$parent_ref" ]] && git -C "$repo_root" show-ref --verify --quiet "refs/heads/$parent_ref" 2>/dev/null; then
    merge_base=$(git -C "$repo_root" merge-base "$branch" "$parent_ref" 2>/dev/null)
  else
    # Try HEAD of main worktree
    merge_base=$(git -C "$repo_root" merge-base "$branch" HEAD 2>/dev/null)
  fi
  if [[ -n "$merge_base" ]]; then
    unique_count=$(git -C "$repo_root" rev-list --count "$merge_base..$branch" 2>/dev/null)
    (( unique_count > 0 )) && has_unique_commits=1
  fi

  if (( ! has_unique_commits )); then
    # Issue cd64f1a — release the branch's exact work unit with its observed
    # custody generation, through the shared ledger client (issue 70dffb8).
    # The client is sourced lazily with the caller's shell options restored,
    # because it turns on `set -u`.
    #
    # Release is advisory: a failed lookup or release prints a visible warning
    # and the worktree is still removed, so auth-merge.sh post-merge cleanup is
    # never aborted by the ledger. A unit bound to an auth request belongs to
    # the merge pipeline, which resolves it; dwt leaves it alone.
    dwt_prev_shell_opts="$(set +o)"
    # shellcheck source=./ledger-client.sh
    source "${MANDIBLE_CLI_DIR:-$(cd "$(dirname "$0")" && pwd)}/ledger-client.sh"
    eval "$dwt_prev_shell_opts"
    dwt_active='[.work_units[]? | select(.state == "open" or .state == "committed")]'
    if ! dwt_units=$(mandible_work_unit_find --repo "$repo_root" --branch "$branch") ||
       ! dwt_count=$(printf '%s' "$dwt_units" | jq -e "$dwt_active | length" 2>/dev/null); then
      printf '%s\n' "warning: could not read the work unit for $branch; it was not released" >&2
    elif (( dwt_count > 1 )); then
      printf '%s\n' "warning: multiple active work units for $branch; none was released" >&2
    elif (( dwt_count == 1 )); then
      dwt_unit=$(printf '%s' "$dwt_units" | jq -c "$dwt_active | .[0]")
      dwt_auth=$(printf '%s' "$dwt_unit" | jq -r '.auth_request_id // empty')
      if [[ -n "$dwt_auth" ]]; then
        printf '%s\n' "note: work unit for $branch is bound to auth request $dwt_auth; left for the merge pipeline" >&2
      elif mandible_work_unit_release \
             --id "$(printf '%s' "$dwt_unit" | jq -r '.id')" \
             --expected-generation "$(printf '%s' "$dwt_unit" | jq -r '.custody_generation')" >/dev/null; then
        printf '%s\n' "note: released work unit for $branch (no unique commits on branch)" >&2
      else
        printf '%s\n' "warning: work-unit release failed for $branch; it was not released" >&2
      fi
    fi
  fi
fi

abs_pwd="$(cd "$PWD" 2>/dev/null && pwd -P)"
abs_wt="$(cd "$wt_dir" 2>/dev/null && pwd -P)"
if [[ -n "$abs_pwd" && -n "$abs_wt" ]]; then
  if [[ "$abs_pwd" == "$abs_wt" || "$abs_pwd" == "$abs_wt"/* ]]; then
    cd "$repo_root" || exit 1
  fi
fi

if (( force )); then
  git -C "$repo_root" worktree remove --force "$wt_dir" || { printf '%s\n' "error: failed to remove worktree" >&2; exit 1; }
else
  git -C "$repo_root" worktree remove "$wt_dir" || { printf '%s\n' "error: failed to remove worktree" >&2; exit 1; }
fi

if (( ! keep_branch )); then
  if (( force )); then
    git -C "$repo_root" branch -D "$branch" >/dev/null 2>&1 || true
  else
    git -C "$repo_root" branch -d "$branch" >/dev/null 2>&1 || true
  fi
fi

printf '%s\n' "$repo_root"
