{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json && node ui/esbuild.config.js",
    "build:server": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "build:channel-server": "node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "channel-server": "node dist/channel-server/index.js",
    "build:ui": "node ui/esbuild.config.js",
    "build:watch": "node ui/esbuild.config.js --watch",
    "dev": "node scripts/run-tsc.js --watch & node ui/esbuild.config.js --watch",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "test": "node scripts/run-vitest.js run",
    "tauri": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@anthropic-ai/sdk": "^0.80.0",
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tauri-apps/api": "^2.10.1",
    "@types/d3": "^7.4.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "d3": "^7.9.0",
    "diff2html": "^3.4.56",
    "marked": "^13.0.2",
    "node-pty": "^1.1.0",
    "preact": "^10.19.3",
    "smol-toml": "^1.6.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/preact": "^3.2.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.20.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
