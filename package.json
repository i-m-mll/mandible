{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "prebuild": "scripts/bun-runtime.sh --exec --no-install scripts/generate-canonical-origin.mjs --check",
    "build": "scripts/bun-runtime.sh --exec --no-install scripts/source-build.mjs build",
    "pretypecheck": "scripts/bun-runtime.sh --exec --no-install scripts/generate-canonical-origin.mjs --check",
    "typecheck": "scripts/bun-runtime.sh --exec --no-install scripts/source-build.mjs typecheck",
    "build:server": "scripts/bun-runtime.sh --exec --no-install scripts/source-build.mjs server",
    "build:channel-server": "scripts/bun-runtime.sh --exec --no-install scripts/source-build.mjs channel",
    "channel-server": "scripts/bun-runtime.sh --exec --no-install dist/channel-server/index.js",
    "build:ui": "scripts/bun-runtime.sh --exec --no-install ui/esbuild.config.js",
    "build:watch": "scripts/bun-runtime.sh --exec --no-install ui/esbuild.config.js --watch",
    "dev": "scripts/bun-runtime.sh --exec --no-install scripts/run-tsc.js --watch & scripts/bun-runtime.sh --exec --no-install ui/esbuild.config.js --watch",
    "iab-preview": "scripts/bun-runtime.sh --exec --no-install scripts/iab-preview.mjs",
    "local-front-door": "scripts/bun-runtime.sh --exec --no-install scripts/local-front-door.mjs",
    "stall-probe": "scripts/bun-runtime.sh --exec --no-install scripts/daemon-stall-probe.mjs",
    "route-cost-sweep": "scripts/bun-runtime.sh --exec --no-install scripts/route-cost-sweep.ts",
    "iab-preview-cleanup": "scripts/bun-runtime.sh --exec --no-install scripts/iab-preview.mjs cleanup",
    "demo:briefing": "scripts/bun-runtime.sh --exec --no-install scripts/demo-briefing.mjs",
    "preview-db-snapshot": "scripts/bun-runtime.sh --exec --no-install scripts/project-db-snapshot.mjs",
    "conversation-cutover": "scripts/bun-runtime.sh --exec --no-install scripts/conversation-cutover-proof.mjs",
    "generate:codex-app-server": "scripts/bun-runtime.sh --exec --no-install scripts/generate-codex-app-server-bindings.mjs",
    "scan:duplication": "scripts/bun-runtime.sh --exec --no-install scripts/ncd-scan.mjs",
    "test:iab-preview-cleanup": "scripts/bun-runtime.sh --exec --no-install scripts/test-iab-preview-cleanup.mjs",
    "test:preview-lifecycle": "scripts/bun-runtime.sh --exec test --timeout 60000 scripts/owned-run.test.mjs scripts/preview-lifecycle.test.mjs",
    "test:briefing-rating-browser": "scripts/bun-runtime.sh --exec --no-install scripts/test-briefing-rating-browser.mjs",
    "test:timeline-layout-browser": "scripts/bun-runtime.sh --exec --no-install scripts/test-timeline-layout-browser.mjs",
    "start": "scripts/bun-runtime.sh --exec --no-install dist/index.js",
    "postinstall": "scripts/bun-runtime.sh --exec --no-install scripts/sqlite-runtime-install.mjs",
    "check": "scripts/bun-runtime.sh --exec --no-install scripts/check.mjs",
    "test": "scripts/bun-runtime.sh --exec --no-install scripts/run-vitest.js run",
    "test:provisioned": "scripts/bun-runtime.sh --exec --no-install scripts/run-provisioned-tests.mjs",
    "test:quarantine": "MANDIBLE_TEST_SUITE=quarantine scripts/bun-runtime.sh --exec --no-install scripts/run-vitest.js run",
    "test:coverage": "scripts/bun-runtime.sh --exec --no-install scripts/run-vitest.js run --coverage",
    "tauri": "scripts/bun-runtime.sh --exec --no-install node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "scripts/bun-runtime.sh --exec --no-install scripts/build-desktop-app.mjs",
    "native-preview": "scripts/bun-runtime.sh --exec scripts/native-preview.mjs",
    "fleet": "scripts/bun-runtime.sh --exec --no-install scripts/mandible-fleet.mjs",
    "candidate-acceptance": "scripts/bun-runtime.sh --exec --no-install scripts/candidate-acceptance.mjs",
    "test:app-payload": "scripts/bun-runtime.sh --exec --no-install scripts/prove-app-payload.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/preact-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.12",
    "chokidar": "4.0.3",
    "jose": "6.2.2",
    "lucide-preact": "1.63.0",
    "remark-directive": "3.0.1",
    "remark-parse": "11.0.0",
    "smol-toml": "1.6.1",
    "unified": "11.0.5",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4",
    "@tauri-apps/cli": "2.10.0",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@testing-library/preact": "3.2.4",
    "@types/dompurify": "3.0.5",
    "@types/node": "22.19.11",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.8",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@xyflow/react": "12.10.2",
    "agentation": "3.1.2",
    "diff2html": "3.4.56",
    "dompurify": "3.4.9",
    "esbuild": "0.28.0",
    "highlight.js": "11.11.1",
    "jsdom": "24.1.3",
    "json5": "2.2.3",
    "marked": "13.0.3",
    "preact": "10.28.3",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "trustedDependencies": []
}
