{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "prebuild": "bun --no-install scripts/generate-canonical-origin.mjs --check",
    "build": "bun --no-install scripts/run-tsc.js && bun --no-install scripts/run-tsc.js -p channel-server/tsconfig.json && bun --no-install scripts/run-tsc.js -p ui/tsconfig.json && bun --no-install ui/esbuild.config.js && bun --no-install scripts/build-revision.mjs write",
    "pretypecheck": "bun --no-install scripts/generate-canonical-origin.mjs --check",
    "typecheck": "bun --no-install scripts/run-tsc.js --noEmit && bun --no-install scripts/run-tsc.js -p channel-server/tsconfig.json --noEmit && bun --no-install scripts/run-tsc.js -p ui/tsconfig.json",
    "build:server": "bun --no-install scripts/run-tsc.js && bun --no-install scripts/run-tsc.js -p channel-server/tsconfig.json",
    "build:channel-server": "bun --no-install scripts/run-tsc.js -p channel-server/tsconfig.json",
    "channel-server": "bun --no-install dist/channel-server/index.js",
    "build:ui": "bun --no-install ui/esbuild.config.js",
    "build:watch": "bun --no-install ui/esbuild.config.js --watch",
    "dev": "bun --no-install scripts/run-tsc.js --watch & bun --no-install ui/esbuild.config.js --watch",
    "iab-preview": "bun --no-install scripts/iab-preview.mjs",
    "local-front-door": "bun --no-install scripts/local-front-door.mjs",
    "iab-preview-cleanup": "bun --no-install scripts/iab-preview.mjs cleanup",
    "demo:briefing": "bun --no-install scripts/demo-briefing.mjs",
    "preview-db-snapshot": "bun --no-install scripts/project-db-snapshot.mjs",
    "conversation-cutover": "bun --no-install scripts/conversation-cutover-proof.mjs",
    "generate:codex-app-server": "bun --no-install scripts/generate-codex-app-server-bindings.mjs",
    "scan:duplication": "bun --no-install scripts/ncd-scan.mjs",
    "test:iab-preview-cleanup": "bun --no-install scripts/test-iab-preview-cleanup.mjs",
    "test:briefing-rating-browser": "bun --no-install scripts/test-briefing-rating-browser.mjs",
    "test:timeline-layout-browser": "bun --no-install scripts/test-timeline-layout-browser.mjs",
    "start": "bun --no-install dist/index.js",
    "postinstall": "bun --no-install scripts/sqlite-runtime-install.mjs",
    "test": "bun --no-install scripts/run-vitest.js run",
    "test:browser": "bun --no-install scripts/run-vitest.js run --config vitest.browser.config.ts",
    "test:extended": "bun --no-install scripts/run-extended-tests.mjs",
    "test:quarantine": "bun --no-install scripts/run-vitest.js run --config vitest.quarantine.config.ts",
    "test:coverage": "bun --no-install scripts/run-vitest.js run --coverage",
    "tauri": "tauri dev",
    "tauri:build": "tauri build",
    "fleet": "bun --no-install scripts/mandible-fleet.mjs",
    "candidate-acceptance": "bun --no-install scripts/candidate-acceptance.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/preact-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.12",
    "chokidar": "4.0.3",
    "jose": "6.2.2",
    "remark-directive": "3.0.1",
    "remark-parse": "11.0.0",
    "smol-toml": "1.6.1",
    "unified": "11.0.5",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4",
    "@tauri-apps/cli": "2.10.0",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@testing-library/preact": "3.2.4",
    "@types/dompurify": "3.0.5",
    "@types/node": "22.19.11",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.8",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@xyflow/react": "12.10.2",
    "agentation": "3.1.2",
    "diff2html": "3.4.56",
    "dompurify": "3.4.9",
    "esbuild": "0.28.0",
    "highlight.js": "11.11.1",
    "jsdom": "24.1.3",
    "marked": "13.0.3",
    "preact": "10.28.3",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "trustedDependencies": []
}
