{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc && node ui/esbuild.config.js",
    "build:server": "tsc",
    "build:ui": "node ui/esbuild.config.js",
    "build:watch": "node ui/esbuild.config.js --watch",
    "dev": "tsc --watch & node ui/esbuild.config.js --watch",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "test": "vitest run",
    "tauri": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "diff2html": "^3.4.56",
    "marked": "^13.0.2",
    "node-pty": "^1.1.0",
    "preact": "^10.19.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/preact": "^3.2.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.20.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
