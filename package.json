{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json && node ui/esbuild.config.js",
    "build:server": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "build:channel-server": "node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "channel-server": "node dist/channel-server/index.js",
    "build:ui": "node ui/esbuild.config.js",
    "build:watch": "node ui/esbuild.config.js --watch",
    "dev": "node scripts/run-tsc.js --watch & node ui/esbuild.config.js --watch",
    "iab-preview": "node scripts/iab-preview.mjs",
    "iab-preview-cleanup": "node scripts/iab-preview.mjs cleanup",
    "preview-db-snapshot": "node scripts/project-db-snapshot.mjs",
    "conversation-cutover": "node scripts/conversation-cutover-proof.mjs",
    "test:iab-preview-cleanup": "node scripts/test-iab-preview-cleanup.mjs",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "test": "node scripts/run-vitest.js run",
    "test:coverage": "node scripts/run-vitest.js run --coverage",
    "tauri": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.0.2",
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.6.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/cli": "~2.10.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@testing-library/preact": "^3.2.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "d3": "^7.9.0",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.9",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^24.0.0",
    "marked": "^13.0.2",
    "preact": "^10.19.3",
    "remark-directive": "^3.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.0.0",
    "unified": "^11.0.5",
    "vitest": "^4.1.8"
  }
}
