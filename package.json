{
  "name": "@mll/mcp-mandible",
  "version": "0.1.0",
  "description": "Mandible core daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/generate-canonical-origin.mjs --check",
    "build": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json && node scripts/run-tsc.js -p ui/tsconfig.json && node ui/esbuild.config.js && node scripts/build-revision.mjs write",
    "pretypecheck": "node scripts/generate-canonical-origin.mjs --check",
    "typecheck": "node scripts/run-tsc.js --noEmit && node scripts/run-tsc.js -p channel-server/tsconfig.json --noEmit && node scripts/run-tsc.js -p ui/tsconfig.json",
    "build:server": "node scripts/run-tsc.js && node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "build:channel-server": "node scripts/run-tsc.js -p channel-server/tsconfig.json",
    "channel-server": "node dist/channel-server/index.js",
    "build:ui": "node ui/esbuild.config.js",
    "build:watch": "node ui/esbuild.config.js --watch",
    "dev": "node scripts/run-tsc.js --watch & node ui/esbuild.config.js --watch",
    "iab-preview": "node scripts/iab-preview.mjs",
    "local-front-door": "node scripts/local-front-door.mjs",
    "iab-preview-cleanup": "node scripts/iab-preview.mjs cleanup",
    "demo:briefing": "node scripts/demo-briefing.mjs",
    "preview-db-snapshot": "node scripts/project-db-snapshot.mjs",
    "conversation-cutover": "node scripts/conversation-cutover-proof.mjs",
    "generate:codex-app-server": "node scripts/generate-codex-app-server-bindings.mjs",
    "scan:duplication": "node scripts/ncd-scan.mjs",
    "test:iab-preview-cleanup": "node scripts/test-iab-preview-cleanup.mjs",
    "test:briefing-rating-browser": "node scripts/test-briefing-rating-browser.mjs",
    "test:timeline-layout-browser": "node scripts/test-timeline-layout-browser.mjs",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "test": "node scripts/run-vitest.js run",
    "test:browser": "node scripts/run-vitest.js run --config vitest.browser.config.ts",
    "test:extended": "node scripts/run-extended-tests.mjs",
    "test:quarantine": "node scripts/run-vitest.js run --config vitest.quarantine.config.ts",
    "test:coverage": "node scripts/run-vitest.js run --coverage",
    "tauri": "tauri dev",
    "tauri:build": "tauri build",
    "fleet": "node scripts/mandible-fleet.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.0.2",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/preact-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.12",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "jose": "6.2.2",
    "node-pty": "^1.1.0",
    "remark-directive": "^3.0.0",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.6.1",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@tauri-apps/cli": "~2.10.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@testing-library/preact": "^3.2.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "agentation": "3.1.2",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.9",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^24.0.0",
    "marked": "^13.0.2",
    "preact": "^10.19.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
